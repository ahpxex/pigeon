#!/bin/zsh
# Drive a running Pigeon instance through its debug driver server.
#
#   scripts/pigeonctl launch            # build products path, starts with driver on
#   scripts/pigeonctl state             # tab list + window info (JSON)
#   scripts/pigeonctl new-tab
#   scripts/pigeonctl select <tab-id>
#   scripts/pigeonctl close <tab-id>
#   scripts/pigeonctl type 'ls -la'     # types text (no newline)
#   scripts/pigeonctl run 'ls -la'      # types text + enter
#   scripts/pigeonctl text              # dump selected tab's screen text
#   scripts/pigeonctl search 'term'     # open find + query; search next|prev|close
#   scripts/pigeonctl screenshot out.png
#   scripts/pigeonctl quit
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${PIGEON_DRIVER_PORT:-8790}"
BASE="http://127.0.0.1:$PORT"
APP="$ROOT/build/Build/Products/Debug/Pigeon.app"
# The dev build only. Match by executable path, never by name: the
# production Pigeon (dev.ahpx.pigeon, /Applications) shares the process
# name and routinely runs alongside — it must never be touched.
DEV_BIN="$APP/Contents/MacOS/Pigeon"

case "$1" in
  launch)
    if pgrep -qf "$DEV_BIN"; then
      echo "Pigeon Dev already running (scripts/pigeonctl quit to stop)" >&2
      exit 1
    fi
    # Must go through LaunchServices (open): a directly exec'd binary from
    # a background shell comes up headless (no window server session for
    # SwiftUI scenes). --env scopes the driver port to this instance only
    # (the old launchctl setenv was user-global and could leak into a
    # production Pigeon launched in the same window).
    open --env "PIGEON_DRIVER_PORT=$PORT" "$APP"
    for _ in {1..50}; do
      if curl -sf "$BASE/state" >/dev/null 2>&1; then
        echo "ready on $BASE"
        exit 0
      fi
      sleep 0.2
    done
    echo "driver did not come up on $BASE" >&2
    exit 1
    ;;
  state)      curl -sf "$BASE/state" ;;
  new-window) curl -sf -X POST "$BASE/windows/new" ;;
  select-window) curl -sf -X POST --data "{\"windowNumber\":$2}" "$BASE/windows/select" ;;
  new-tab)    curl -sf -X POST "$BASE/tabs/new" ;;
  select)     curl -sf -X POST --data "{\"id\":\"$2\"}" "$BASE/tabs/select" ;;
  close)      curl -sf -X POST --data "{\"id\":\"$2\"}" "$BASE/tabs/close" ;;
  move)       curl -sf -X POST --data "{\"id\":\"$2\",\"index\":$3}" "$BASE/tabs/move" ;;
  rename)     curl -sf -X POST --data "{\"id\":\"$2\",\"title\":\"$3\"}" "$BASE/tabs/rename" ;;
  icon)       curl -sf -X POST --data "{\"id\":\"$2\",\"icon\":\"$3\"}" "$BASE/tabs/icon" ;;
  group-new)  curl -sf -X POST --data "{\"name\":\"$2\"}" "$BASE/groups/new" ;;
  group-expand) curl -sf -X POST --data "{\"id\":\"$2\",\"expanded\":$3}" "$BASE/groups/expand" ;;
  group-assign)
    if [ "$3" = "none" ]; then
      curl -sf -X POST --data "{\"tabId\":\"$2\",\"groupId\":null}" "$BASE/groups/assign"
    else
      curl -sf -X POST --data "{\"tabId\":\"$2\",\"groupId\":\"$3\"}" "$BASE/groups/assign"
    fi
    ;;
  type)       printf '%s' "$2" | curl -sf -X POST --data-binary @- "$BASE/input/text" ;;
  key)        curl -sf -X POST --data "{\"key\":\"$2\"}" "$BASE/input/key" ;;
  run)
    printf '%s' "$2" | curl -sf -X POST --data-binary @- "$BASE/input/text" >/dev/null
    curl -sf -X POST --data '{"key":"enter"}' "$BASE/input/key"
    ;;
  text)       curl -sf "$BASE/text" ;;
  sidebar)
    case "$2" in
      "")        curl -sf "$BASE/sidebar" ;;
      show)      curl -sf -X POST --data '{"collapsed":false}' "$BASE/sidebar" ;;
      hide)      curl -sf -X POST --data '{"collapsed":true}' "$BASE/sidebar" ;;
      *)         curl -sf -X POST --data "{\"width\":$2}" "$BASE/sidebar" ;;
    esac
    ;;
  screenshot)
    out="${2:-pigeon.png}"
    win=$(curl -sf "$BASE/state" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["windowNumber"])')
    screencapture -x -o -l "$win" "$out"
    echo "$out"
    ;;
  settings)
    if [ -z "$2" ]; then
      curl -sf "$BASE/settings"
    else
      curl -sf -X POST --data "$2" "$BASE/settings"
    fi
    ;;
  search)
    case "$2" in
      "")     curl -sf "$BASE/search" ;;
      next)   curl -sf -X POST "$BASE/search/next" ;;
      prev)   curl -sf -X POST "$BASE/search/prev" ;;
      close)  curl -sf -X POST "$BASE/search/close" ;;
      *)      curl -sf -X POST --data "{\"query\":$(printf '%s' "$2" | /usr/bin/python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')}" "$BASE/search" ;;
    esac
    ;;
  reload-config) curl -sf -X POST "$BASE/config/reload" ;;
  quit)       pkill -f "$DEV_BIN" ;;
  *)
    sed -n '2,15p' "$0" >&2
    exit 1
    ;;
esac
echo ""
