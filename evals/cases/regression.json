  {
    "name": "write-file-confirm-allow",
    "prompt": "eval write file allow",
    "fixture": {},
    "confirm": "allow",
    "turns": [
      {
        "tool_calls": [
          {
            "name": "write_file",
            "arguments": {
              "path": "note.txt",
              "content": "hello pigeon\n"
            }
          }
        ]
      },
      {
        "text": "created it\n"
      }
    ],
    "expect": [
      {
        "type": "contains",
        "value": "[confirm-request] write_file note.txt"
      },
      {
        "type": "contains",
        "value": "new file"
      },
      {
        "type": "tool_used",
        "value": "write_file"
      },
      {
        "type": "fixture_exists",
        "value": "note.txt",
        "contains": "hello pigeon"
      },
      {
        "type": "contains",
        "value": "created it"
      },
      {
        "type": "no_error"
      }
    ]
  },
  {
    "name": "write-file-confirm-deny",
    "prompt": "eval write file deny",
    "fixture": {},
    "confirm": "deny",
    "turns": [
      {
        "tool_calls": [
          {
            "name": "write_file",
            "arguments": {
              "path": "note.txt",
              "content": "hello pigeon\n"
            }
          }
        ]
      },
      {
        "text": "okay, not writing\n"
      }
    ],
    "expect": [
      {
        "type": "contains",
        "value": "[confirm-request] write_file note.txt"
      },
      {
        "type": "contains",
        "value": "declined"
      },
      {
        "type": "fixture_missing",
        "value": "note.txt"
      },
      {
        "type": "contains",
        "value": "okay, not writing"
      }
    ]
  },
  {
    "name": "mutating-command-confirm-allow",
    "prompt": "eval mutating rename",
    "fixture": {
      "a.txt": "content\n"
    },
    "confirm": "allow",
    "turns": [
      {
        "tool_calls": [
          {
            "name": "run_mutating_command",
            "arguments": {
              "pipeline": [
                [
                  "mv",
                  "a.txt",
                  "b.txt"
                ]
              ]
            }
          }
        ]
      },
      {
        "text": "renamed\n"
      }
    ],
    "expect": [
      {
        "type": "contains",
        "value": "[confirm-request] mv a.txt b.txt"
      },
      {
        "type": "contains",
        "value": "⏺ run_mutating_command: mv a.txt b.txt"
      },
      {
        "type": "fixture_exists",
        "value": "b.txt",
        "contains": "content"
      },
      {
        "type": "fixture_missing",
        "value": "a.txt"
      },
      {
        "type": "contains",
        "value": "renamed"
      }
    ]
  },
  {
    "name": "mutating-remote-git-rejected",
    "prompt": "eval mutating git push",
    "fixture": {},
    "confirm": "allow",
    "turns": [
      {
        "tool_calls": [
          {
            "name": "run_mutating_command",
            "arguments": {
              "pipeline": [
                [
                  "git",
                  "push",
                  "origin",
                  "main"
                ]
              ]
            }
          }
        ]
      },
      {
        "text": "cannot push\n"
      }
    ],
    "expect": [
      {
        "type": "contains",
        "value": "not a local mutating subcommand"
      },
      {
        "type": "contains",
        "value": "cannot push"
      }
    ]
  }
