 /// Load the configuration from the default file locations. This
 /// is usually done first. The default file locations are locations
 /// such as the home directory.
+/// Load the configuration from an explicit file path. This lets
+/// embedders own their configuration location instead of inheriting
+/// the default XDG / Application Support search paths.
+export fn ghostty_config_load_file(self: *Config, path: [*:0]const u8) void {
+    self.loadFile(state.alloc, std.mem.sliceTo(path, 0)) catch |err| {
+        log.err("error loading config file err={}", .{err});
+    };
+}
